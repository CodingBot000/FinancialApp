# Remote/demo migration template. Do not replace placeholders in this tracked file.
# Copy to an ignored file or export values only after Stage 11 is separately approved.
APP_ENV=demo
NODE_ENV=production
PLATFORM_MIGRATION_DATABASE_URL=postgresql://financial_migration:<LIGHTSAIL_DB_PASSWORD>@<LIGHTSAIL_DB_HOST>:5432/<DATABASE_NAME>?sslmode=verify-full
SIMULATOR_MIGRATION_DATABASE_URL=postgresql://financial_migration:<LIGHTSAIL_DB_PASSWORD>@<LIGHTSAIL_DB_HOST>:5432/<DATABASE_NAME>?sslmode=verify-full
PLATFORM_DATABASE_URL=postgresql://financial_platform_app:<LIGHTSAIL_PLATFORM_DB_PASSWORD>@<LIGHTSAIL_DB_HOST>:5432/<DATABASE_NAME>?sslmode=verify-full
SIMULATOR_DATABASE_URL=postgresql://financial_simulator_app:<LIGHTSAIL_SIMULATOR_DB_PASSWORD>@<LIGHTSAIL_DB_HOST>:5432/<DATABASE_NAME>?sslmode=verify-full
AWS_REGION=<AWS_REGION>
AWS_KMS_KEY_ARN=<AWS_KMS_KEY_ARN>
AWS_KMS_HMAC_KEY_ARN=<AWS_KMS_HMAC_KEY_ARN>
FINAPP_DATASET_VERSION=FINANCIAL_APP_DATASET_V1
