NODE_ENV=development
APP_ENV=local
EXPO_PUBLIC_APP_ENV=local
PLATFORM_API_PORT=8081
SIMULATOR_API_PORT=8082
EXPO_PUBLIC_PLATFORM_API_MODE=http
EXPO_PUBLIC_PLATFORM_API_URL=http://localhost:8081
EXPO_PUBLIC_CONTRACT_VERSION=platform-v1
