EXPO_PUBLIC_OIDC_CLIENT_ID=finapp-mobile
FINAPP_DATASET_VERSION=baseline-v1

# Remote database values stay empty until the user approves the first connection.
PLATFORM_DATABASE_URL=
SIMULATOR_DATABASE_URL=
