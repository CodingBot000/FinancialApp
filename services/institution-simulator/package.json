{
  "name": "@finapp/institution-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "architecture": "depcruise --config dependency-cruiser.mjs src",
    "build": "nest build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "npm run build && node dist/database/migrate-cli.js",
    "lint": "eslint src test vitest.config.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10"
  }
}
