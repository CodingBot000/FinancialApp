{
  "name": "financial-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "contract:check": "npm run contract:lint && node scripts/validate-contract-fixtures.mjs",
    "contract:lint": "redocly lint contracts/openapi/platform-v1.yaml contracts/openapi/institution-simulator-v1.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run format:check && npm run contract:check && npm run dependency:check -w @finapp/mobile && npm run security:secrets && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@redocly/cli": "2.49.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
