# Committed, non-secret workspace template. Copy values to your shell or an ignored secret file.
APP_ENV=local
NODE_ENV=development
FINAPP_DATASET_VERSION=FINANCIAL_APP_DATASET_V1
PLATFORM_API_PORT=8081
SIMULATOR_API_PORT=8082
PLATFORM_DATABASE_URL=postgresql://financial_platform_app:<LOCAL_PLATFORM_DB_PASSWORD>@127.0.0.1:5433/financial_app
SIMULATOR_DATABASE_URL=postgresql://financial_simulator_app:<LOCAL_SIMULATOR_DB_PASSWORD>@127.0.0.1:5433/financial_app
PLATFORM_MIGRATION_DATABASE_URL=postgresql://financial_migration:<LOCAL_MIGRATION_DB_PASSWORD>@127.0.0.1:5433/financial_app
SIMULATOR_MIGRATION_DATABASE_URL=postgresql://financial_migration:<LOCAL_MIGRATION_DB_PASSWORD>@127.0.0.1:5433/financial_app
INSTITUTION_SIMULATOR_BASE_URL=http://127.0.0.1:8082
OIDC_ISSUER=http://127.0.0.1:8083/realms/finapp
OIDC_AUDIENCE=finapp-platform-api
OIDC_JWKS_URI=http://127.0.0.1:8083/realms/finapp/protocol/openid-connect/certs

# Local-only synthetic values; never use these names for real credentials.
FINAPP_MYDATA_ENCRYPTION_KEY_BASE64=<LOCAL_32_BYTE_BASE64_KEY>
FINAPP_MYDATA_ENCRYPTION_KEY_VERSION=local-v1
FINAPP_SECURITY_EVENT_HASH_KEY_BASE64=<LOCAL_32_BYTE_BASE64_HASH_KEY>
