{
  "expo": {
    "name": "Wealth Flow",
    "slug": "wealth-sandbox",
    "version": "0.1.1",
    "icon": "./assets/icon-wm.png",
    "orientation": "portrait",
    "scheme": "wealthsandbox",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wealth Flow 앱 잠금을 해제하기 위해 Face ID를 사용합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wealth Flow에서 신분증 촬영 기능을 시연하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wealth Flow에서 신분증 촬영 기능을 시연하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "photosPermission": "Wealth Flow에서 프로필 사진 등록 기능을 시연하기 위해 사진을 사용합니다."
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wealthsandbox"
    },
    "android": {
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.anonymous.wealthsandbox"
    }
  }
}
