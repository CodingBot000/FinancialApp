{
  "expo": {
    "name": "Wealth Flow",
    "slug": "wealth-sandbox",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wealthsandbox",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wealth Flow 앱 잠금을 해제하기 위해 Face ID를 사용합니다."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wealthsandbox"
    },
    "android": {
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.anonymous.wealthsandbox"
    }
  }
}
