{
  "expo": {
    "name": "Wealth Sandbox",
    "slug": "wealth-sandbox",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wealthsandbox",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Wealth Sandbox 앱 잠금을 해제하기 위해 Face ID를 사용합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {}
  }
}
