{
  "name": "@finapp/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "dependency:check": "expo install --check",
    "ios": "expo start --ios",
    "lint": "eslint src vitest.config.ts expo-env.d.ts",
